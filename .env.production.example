NODE_ENV=production
PORT=3000
WEB_PORT=80
SERVE_STATIC=false
DATA_ROOT=/mnt/data
TRUST_PROXY_HOPS=1
CORS_ORIGIN=https://example.com

POSTGRES_DB=aac_gbeaa
POSTGRES_USER=aac
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgres://aac:replace-with-strong-db-password@postgres:5432/aac_gbeaa

JWT_SECRET=replace-with-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
SESSION_SECRET=replace-with-long-random-session-secret
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
ENCRYPTION_KEY=replace-with-long-random-encryption-key

ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-bootstrap-password
ADMIN_SUPER_USERNAME=superadmin
ADMIN_SUPER_PASSWORD=replace-with-strong-superadmin-password
ADMIN_EDITOR_USERNAME=editoradmin
ADMIN_EDITOR_PASSWORD=
ADMIN_MODERATOR_USERNAME=moderatoradmin
ADMIN_MODERATOR_PASSWORD=
ADMIN_VIEWER_USERNAME=vieweradmin
ADMIN_VIEWER_PASSWORD=

TEMP_PASSWORD_VALID_HOURS=12
PASSWORD_MAX_AGE_DAYS=90
TEMP_PASSWORD_MIN_HOURS=1
TEMP_PASSWORD_MAX_HOURS=24

MAX_FILE_SIZE=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
HOT_CACHE_ENABLED=true
HOT_CACHE_TTL_MS=30000

REDIS_URL=
REDIS_SESSION_PREFIX=aac:sess:
